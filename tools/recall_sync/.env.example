# Copy this file to ~/Code/_runtime/recall-anki-sync/.env, fill the values,
# and keep the destination owner-only (mode 0600). Never commit the real file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_USER_ID=

# Optional override. The default is ~/Code/METIS/graph/concepts.yaml.
# METIS_CONCEPTS_YAML=/absolute/path/to/concepts.yaml
