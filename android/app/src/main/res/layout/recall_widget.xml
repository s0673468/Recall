<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recall_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/widget_description"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:text="RECALL"
        android:textColor="#FDE047"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/recall_widget_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/recall_widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#C7C5D2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/recall_widget_action"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_action_background"
        android:contentDescription="@string/widget_start_study"
        android:gravity="center"
        android:text="@string/widget_start_study"
        android:textColor="#202038"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/recall_widget_freshness"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="#A9A7B5"
        android:textSize="10sp" />
</LinearLayout>
