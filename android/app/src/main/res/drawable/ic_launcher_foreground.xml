<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground is derived from the canonical iOS Recall icon rather than a
  separately redrawn Android path. Each density places the original mark on a
  transparent 108dp adaptive-icon canvas, with the source artwork scaled into
  the 72dp mask area so every launcher shape preserves the iOS proportions.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:antialias="true"
    android:filter="true"
    android:gravity="fill"
    android:src="@drawable/ic_launcher_foreground_bitmap" />
